# Copy to .env (git-ignored) and fill in on YOUR machine only. Never paste these into chat.

# Firebase: Console → Project settings → Service accounts → Generate new private key.
# Save the file in this folder as firebase-service-account.json (git-ignored).
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Firebase: Console → Authentication → Users → ⋮ → Password hash parameters.
# Leave blank to import users without passwords (they then reset their password at cutover).
FIREBASE_HASH_SIGNER_KEY=
FIREBASE_HASH_SALT_SEPARATOR=
FIREBASE_HASH_ROUNDS=
FIREBASE_HASH_MEM_COST=

# Supabase: Dashboard → Project Settings → API Keys → secret key named "swetha_server".
SUPABASE_URL=https://bzwxrmltwbmglxhwywhr.supabase.co
SUPABASE_SECRET_KEY=
